{
    "TCP": {
        "443": {
            "HTTPS": true
        },
        "80": {
            "HTTPS": false
        }
    },
    "Web": {
        "${TS_CERT_DOMAIN}:443": {
            "Handlers": {
                "/": {
                    "Proxy": "http://web:8080"
                },
                "/healthz": {
                    "Text": "ok"
                }
            }
        },
        "${TS_CERT_DOMAIN}:80": {
            "Handlers": {
                "/": {
                    "Proxy": "http://web:8080"
                }
            }
        }
    },
    "AllowFunnel": {
        "${TS_CERT_DOMAIN}:443": false
    }
}